{
  "name": "signalloop",
  "private": true,
  "type": "module",
  "description": "SignalLoop: AI-assisted marketing experimentation. Deterministic analytics, a Marketing Agent and a Content Agent on Netlify Functions.",
  "scripts": {
    "dev": "node --env-file-if-exists=.env netlify/dev-server.mjs",
    "check:ai": "node --env-file-if-exists=.env netlify/scripts/check-providers.mjs",
    "try:loop": "node --env-file-if-exists=.env netlify/scripts/try-loop.mjs",
    "test": "node --test netlify/test/*.test.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "^11.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
