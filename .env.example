# Local configuration for SignalLoop.
# Copy this file to .env (git ignores .env) and fill in your own keys:
#   cp .env.example .env
# Never commit .env or paste keys into issues or chat. In production, set the same
# variables in Vercel (Project Settings -> Environment Variables) and mark keys as Sensitive.

# --- AI agents (Groq first, Gemini as fallback) ---
# Groq key: https://console.groq.com/keys
GROQ_API_KEY=
# Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# The models themselves are set in lib/llm.mjs.

# --- HubSpot CRM ---
# Leave HUBSPOT_MODE=mock for local testing. Setting it to live writes the fictional
# sample contacts and lists to the HubSpot account the key belongs to.
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_MODE=mock

# --- Storage (experiment history, usage limits) ---
# On Vercel, connecting Upstash Redis from the Marketplace adds these for you
# (named KV_REST_API_URL / KV_REST_API_TOKEN, which also work).
# Leave empty locally: history is then kept in memory while the dev server runs.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
