# =========================================================================
# SignalLoop — environment configuration
# Copy this file to ".env" and fill in keys to switch from MOCK to LIVE mode.
# The pipeline runs end-to-end with NO keys at all (everything mocks cleanly).
# =========================================================================

# --- LLM (content generation + AI performance summary) --------------------
# If unset, the pipeline uses a deterministic template-based mock generator.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- HubSpot CRM ----------------------------------------------------------
# Private App token (https://developers.hubspot.com/). If unset, the CRM
# client runs in MOCK mode: it builds the exact real request (endpoint +
# payload) and logs it instead of sending. Switch HUBSPOT_MODE=live to send.
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_MODE=mock          # "mock" or "live"

# --- Engagement simulation ------------------------------------------------
# Seed makes simulated open/click/unsub rates reproducible. Leave blank for
# fresh randomness on every run.
SIM_SEED=42
